{
  "name": "safebox",
  "version": "0.1.0",
  "description": "秘匣 (SafeBox) desktop application",
  "author": "Lireth",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "scripts": {
    "dev": "npm run build:electron:dev && concurrently -k \"vite\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron:dev": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && cross-env NODE_ENV=production electron-builder",
    "build:dir": "npm run build:renderer && tsc -p tsconfig.electron.json && cross-env NODE_ENV=production electron-builder --dir",
    "release": "npm run build:renderer && tsc -p tsconfig.electron.json && cross-env NODE_ENV=production electron-builder --publish always",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.3.5",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true
  }
}
